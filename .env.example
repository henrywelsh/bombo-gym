# Supabase Postgres connection strings (Project → Settings → Database).
# DATABASE_URL  — the app/auth use this. Use the TRANSACTION pooler (port 6543);
#                 it works in serverless and resolves over IPv4 locally too.
# DATABASE_URL_DIRECT — used only by `npm run db:migrate`. Use the SESSION pooler
#                 (port 5432, host *.pooler.supabase.com): a real session, so it
#                 supports DDL and migration advisory locks, and it resolves over
#                 IPv4. Prefer it over the direct connection (db.<ref>.supabase.co),
#                 which is IPv6-only and fails with ENETUNREACH on IPv4-only networks
#                 such as WSL2.
DATABASE_URL=postgres://postgres.<ref>:<password>@<region>.pooler.supabase.com:6543/postgres
DATABASE_URL_DIRECT=postgres://postgres.<ref>:<password>@<region>.pooler.supabase.com:5432/postgres

# Google OAuth — from Google Cloud Console
# Authorized redirect URI: ${APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google account allowed to edit the shared daily challenge (everyone else is read-only).
ADMIN_EMAIL=henry.r.welsh@gmail.com

# better-auth session secret — generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Public URL of the deployed app (no trailing slash). better-auth derives the cookie
# domain and CSRF origin from this. Local (vercel dev): http://localhost:3000.
# Prod: your Vercel URL, e.g. https://bombo-gym.vercel.app
APP_URL=http://localhost:3000
